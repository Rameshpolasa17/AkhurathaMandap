# Cloudflare Pages — response headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Angular fingerprints these filenames on every build, so a given URL can
# never change content — cache it for a year.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Festival photos are not fingerprinted, so cache for a month rather than
# forever — replacing a photo then takes effect within weeks, not never.
/assets/*
  Cache-Control: public, max-age=2592000
/images/*
  Cache-Control: public, max-age=2592000

# The entry point must revalidate, or visitors keep an old deploy's script tags.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
